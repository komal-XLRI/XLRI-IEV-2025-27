# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb://127.0.0.1:27017/iev_tracker"

# ─── Session ─────────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ─── Email OTP delivery (optional in development) ───────────────────────────
# Without SMTP configured, OTP codes are printed to the server console
# and (in development only) returned by the API so you can log in locally.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# REQUIRED whenever SMTP_HOST is set. Must be an address on a domain you have
# verified with your mail provider — providers reject unverified senders with
# "553 Sender is not allowed to relay", which blocks every sign-in.
SMTP_FROM="IEV Portal <no-reply@your-verified-domain.com>"

# ─── Google Drive (optional) ─────────────────────────────────────────────────
# Service account with access to the IEV Drive folders.
# If unset, the portal runs normally and Drive features show a
# "not configured" state instead of failing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Optional: shared drive / root folder that new uploads are nested under
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# ─── Bootstrap ───────────────────────────────────────────────────────────────
# This email is granted the ADMIN role by `npm run seed`.
SEED_ADMIN_EMAIL="admin@xlri.ac.in"
SEED_ADMIN_NAME="IEV Administrator"

# ─── Master sign-in code (break-glass, optional) ─────────────────────────────
# A 6-digit code accepted in place of the emailed one, for when mail delivery
# is down. It does NOT skip the OTP flow: request a code as usual, then type
# this instead — the 10-minute expiry and the 5-attempt cap still apply.
# Leave empty to switch the fallback off. Repeated or sequential digits are
# refused. Change it whenever someone who knew it leaves the office.
MASTER_OTP=""
# Comma-separated addresses allowed to use it. Empty means every active
# account, so anyone holding the code could sign in as any student — keep this
# limited to the IEV office.
MASTER_OTP_EMAILS="admin@xlri.ac.in"
